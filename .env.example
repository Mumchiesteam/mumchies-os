POSTGRES_DB=mumchies_os
POSTGRES_USER=mumchies
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://mumchies:change-me@localhost:5432/mumchies_os
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATA_DIR=./data
AUTH_ENABLED=true
AUTH_ADMIN_USERNAME=
# Generate with: cd backend; python -m app.core.auth hash-password
AUTH_ADMIN_PASSWORD_HASH=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SESSION_SECRET=
AUTH_SESSION_MINUTES=480
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_CLIENT_ID=your_shopify_client_id
SHOPIFY_CLIENT_SECRET=your_shopify_client_secret
SHOPIFY_API_VERSION=2025-10
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP=
DELHIVERY_TOKEN=
DELHIVERY_PICKUP=
SHADOWFAX_API_TOKEN=
# Temporary legacy fallback. Prefer SHADOWFAX_API_TOKEN.
SHADOWFAX_TOKEN=
# API root only, not an endpoint: https://dale.shadowfax.in/api
SHADOWFAX_BASE_URL=https://dale.shadowfax.in/api
